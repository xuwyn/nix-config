#!/usr/bin/env bash
#
# Nix-built DMS/quickshell (e.g. via home-manager on non-NixOS)
# looks for unix_chkpwd at /run/wrappers/bin/unix_chkpwd (NixOS-only path),
# causing lock screen/greeter auth to fail on non-NixOS distros
#
# Fix: symlink /run/wrappers/bin/unix_chkpwd to real system unix_chkpwd,
# registered via systemd-tmpfiles so it survives reboots

set -euo pipefail

TMPFILES_CONF="/etc/tmpfiles.d/dms-pam.conf"

if [[ "${EUID}" -ne 0 ]]; then
  echo "This script must be run as root (it writes to /etc and /run)" >&2
  echo "Re-run with: sudo $0" >&2
  exit 1
fi

# Locate the real unix_chkpwd binary
UNIX_CHKPWD=""
for candidate in /usr/bin/unix_chkpwd /usr/sbin/unix_chkpwd /bin/unix_chkpwd /sbin/unix_chkpwd; do
  if [[ -x "${candidate}" ]]; then
    UNIX_CHKPWD="${candidate}"
    break
  fi
done

if [[ -z "${UNIX_CHKPWD}" ]]; then
  echo "Could not find a unix_chkpwd binary on this system." >&2
  echo "Try searching manually with: sudo find / -name unix_chkpwd 2>/dev/null" >&2
  exit 1
fi

# Sanity check: real unix_chkpwd should be setuid-root (rwsr-xr-x, owner root)
PERMS="$(stat -c '%A %U' "${UNIX_CHKPWD}")"
if [[ "${PERMS}" != s* ]] && [[ "${PERMS}" != *"rws"* ]]; then
  echo "Warning: ${UNIX_CHKPWD} does not appear to be setuid-root (${PERMS})." >&2
  echo "The tmpfiles.d rule will still be created, but auth may not work correctly." >&2
fi

echo "Found unix_chkpwd at: ${UNIX_CHKPWD} (${PERMS})"

# Write the tmpfiles.d rule: recreate /run/wrappers/bin and the symlink on
# every boot (d = ensure directory exists; L+ = force-create symlink)
cat >"${TMPFILES_CONF}" <<EOF
d /run/wrappers 0755 root root -
d /run/wrappers/bin 0755 root root -
L+ /run/wrappers/bin/unix_chkpwd - - - - ${UNIX_CHKPWD}
EOF

echo "Wrote ${TMPFILES_CONF}"

# Apply immediately so it takes effect without a reboot.
systemd-tmpfiles --create "${TMPFILES_CONF}"

echo "Created /run/wrappers/bin/unix_chkpwd -> ${UNIX_CHKPWD}"
echo
echo "This symlink persists across reboots via ${TMPFILES_CONF}."
